include(BundleUtilities)
set(_app "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/av_screen_cast.app")
# Homebrew's plugin path is a relative symlink into its Cellar. Copy the
# resolved file, never that symlink, into the relocatable application bundle.
set(_platforms "${_app}/Contents/PlugIns/platforms")
if(IS_SYMLINK "${_platforms}/libqoffscreen.dylib")
  file(REMOVE "${_platforms}/libqoffscreen.dylib")
endif()
file(COPY "@SCREEN_CAST_QT_OFFSCREEN@" DESTINATION "${_platforms}")
fixup_bundle("${_app}" "${_app}/Contents/PlugIns/platforms/libqoffscreen.dylib" "@SCREEN_CAST_QT_LIBS@;@LIVEKIT_LLVM_ROOT@/lib/c++;@LIVEKIT_LLVM_ROOT@/lib/unwind")
# Native dependencies may require a newer OS than our source-level minimum.
set(_minimum "@CMAKE_OSX_DEPLOYMENT_TARGET@")
file(GLOB_RECURSE _libraries "${_app}/Contents/*.dylib")
list(APPEND _libraries "${_app}/Contents/MacOS/av_screen_cast")
file(GLOB _frameworks "${_app}/Contents/Frameworks/*.framework")
foreach(_framework IN LISTS _frameworks)
  get_filename_component(_name "${_framework}" NAME_WE)
  if(EXISTS "${_framework}/${_name}")
    list(APPEND _libraries "${_framework}/${_name}")
  endif()
endforeach()
foreach(_library IN LISTS _libraries)
  execute_process(COMMAND /usr/bin/otool -l "${_library}" OUTPUT_VARIABLE _headers COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCHALL "minos [0-9.]+" _versions "${_headers}")
  foreach(_version IN LISTS _versions)
    string(REPLACE "minos " "" _version "${_version}")
    if(_version VERSION_GREATER _minimum)
      set(_minimum "${_version}")
    endif()
  endforeach()
endforeach()
execute_process(COMMAND /usr/libexec/PlistBuddy -c "Set :LSMinimumSystemVersion ${_minimum}" "${_app}/Contents/Info.plist" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Packaged screen-cast requires macOS ${_minimum} or later")
# Local ad-hoc signature only; Developer ID and notarization are not performed.
execute_process(COMMAND /usr/bin/codesign --force --deep --sign - "${_app}" COMMAND_ERROR_IS_FATAL ANY)
